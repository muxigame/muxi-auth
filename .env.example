# Public origin of the identity service. No trailing slash.
MUXI_ISSUER=https://account.muxigame.com
MUXI_DATABASE_PATH=data/muxi-auth.db
MUXI_SIGNING_KEY_PATH=data/oidc-signing.pem
MUXI_ENABLE_DOCS=0

# Browser account session.
MUXI_WEB_SESSION_DAYS=30
MUXI_ACCESS_TOKEN_SECONDS=3600
MUXI_REFRESH_TOKEN_DAYS=30

# Better MC website: confidential OAuth client.
MUXI_BMC_WEB_CLIENT_ID=better-mc-web
MUXI_BMC_WEB_CLIENT_SECRET=change-me-to-a-long-random-secret
MUXI_BMC_WEB_REDIRECT_URI=https://mc.muxigame.com/api/v1/auth/callback

# Better MC launcher: native/public client. Runtime loopback ports are allowed.
MUXI_BMC_LAUNCHER_CLIENT_ID=better-mc-launcher
MUXI_BMC_LAUNCHER_REDIRECT_URI=http://127.0.0.1/oauth/callback

# Transactional email.
MUXI_SMTP_HOST=smtpdm.aliyun.com
MUXI_SMTP_PORT=465
MUXI_SMTP_SSL=1
MUXI_SMTP_USERNAME=no-reply@muxigame.com
MUXI_SMTP_PASSWORD=
MUXI_SMTP_FROM="Muxi Account <no-reply@muxigame.com>"

# Local development only. Verification links are returned by the API when enabled.
MUXI_AUTH_DEV_VERIFY=0

# CZL Connect upstream identity broker. QQ / WeChat buttons remain hidden
# until both values are configured. The callback registered in CZL must be:
# https://account.muxigame.com/external/czl/callback
MUXI_CZL_CLIENT_ID=
MUXI_CZL_CLIENT_SECRET=
MUXI_CZL_AUTHORIZE_ENDPOINT=https://connect.czl.net/oauth2/authorize
MUXI_CZL_TOKEN_ENDPOINT=https://connect.czl.net/api/oauth2/token
MUXI_CZL_USERINFO_ENDPOINT=https://connect.czl.net/api/oauth2/userinfo

